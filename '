#include "shape.h"

namespace PhysicsEngine {

Shape Shape::make_box(float hx, float hy, float hz) {
    Shape s;
    s.type = ShapeType::box;
    s.box = {make_vec3(hz, hy, hz)};
    return s;
}

Shape Shape::make_sphere(float radius) {
    Shape s;
    s.type = ShapeType::sphere;
    s.sphere = {radius};
    return s;
}

